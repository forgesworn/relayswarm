PUBLIC_URL=https://stream.example.org
APP_PORT=8787
INGEST_PORT=1935
APP_TAG=local
SOURCE_REVISION=unreleased
# Comma-separated credential-free wss URLs; empty uses the built-in relay.
RELAYS=
# Optional STUN only. No TURN credentials are accepted here.
STUN_URL=
# Required only for compose.youtube.yml; directory owner must be uid 1000, mode 0700.
# YOUTUBE_SECRET_DIR=/srv/relayswarm-youtube
