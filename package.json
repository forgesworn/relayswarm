{
  "name": "relayswarm",
  "version": "0.1.0",
  "description": "Experimental peer-assisted HLS video over WebRTC and Nostr relays, with signed segment commitments and a native HyperDHT proof of concept",
  "scripts": {
    "poc": "node poc.mjs",
    "poc:native": "node native-poc.mjs",
    "test": "node test/e2e.mjs",
    "test:native": "node --test test/native-*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "audit": "npm audit --audit-level=high",
    "test:browser": "node test/hls-swarm-browser.mjs",
    "test:swarm": "node --test test/hls-swarm.test.mjs test/browser-hardening.test.mjs",
    "test:publisher": "node --test test/hls-publisher.test.mjs test/demo-server.test.mjs",
    "test:playback": "node test/hls-playback-browser.mjs",
    "demo": "node demo/server.mjs",
    "docs:generate": "node scripts/build-ai-context.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "keywords": [
    "nostr",
    "nip-53",
    "webrtc",
    "hls",
    "hls.js",
    "peer-to-peer",
    "peer-assisted",
    "live-streaming",
    "video-streaming",
    "hyperdht",
    "signed-segment-commitments",
    "proof-of-concept"
  ],
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "homepage": "https://github.com/forgesworn/relayswarm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/relayswarm.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hyperdht": "6.33.2",
    "nostr-tools": "^2.24.1",
    "werift": "^0.24.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "hls.js": "1.7.3",
    "playwright-core": "1.63.0"
  },
  "exports": {
    ".": "./src/relay-session.mjs",
    "./hls-swarm": "./src/browser/hls-swarm.mjs",
    "./package.json": "./package.json",
    "./*": "./*",
    "./segment-commitment": "./src/browser/segment-commitment.mjs",
    "./hls-publisher": "./src/hls-publisher.mjs"
  },
  "bugs": {
    "url": "https://github.com/forgesworn/relayswarm/issues"
  }
}
