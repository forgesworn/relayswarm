+static void agent_release_turn_allocations(juice_agent_t *agent) {
+	/* Keep the existing socket/IO alive briefly so authenticated 438 nonce
+	 * challenges can be processed. All closing sends are Refresh(0), capped
+	 * at six per entry and 500 ms total; a partition still needs expiry. */
+	conn_lock(agent);
+	agent->turn_closing = true;
+	for (int i = 0; i < agent->entries_count; ++i) {
+		agent_stun_entry_t *entry = agent->entries + i;
+		if (!entry->turn)
+			continue;
+		entry->turn->release_pending = entry->type == AGENT_STUN_ENTRY_TYPE_RELAY &&
+		                                 *entry->turn->credentials.nonce;
+		entry->turn->release_complete = false;
+		entry->turn->release_requests = 0;
+		if (entry->turn->release_pending) {
+			juice_random(entry->transaction_id, sizeof(entry->transaction_id));
+			entry->transaction_id_expired = false;
+			entry->next_transmission = 0;
+		}
+	}
+	conn_unlock(agent);
+
+	timestamp_t deadline = current_timestamp() + 500;
+	timestamp_t next_send = 0;
+	for (;;) {
+		timestamp_t now = current_timestamp();
+		bool pending = false;
+		conn_lock(agent);
+		for (int i = 0; i < agent->entries_count; ++i) {
+			agent_stun_entry_t *entry = agent->entries + i;
+			if (!entry->turn || !entry->turn->release_pending || entry->turn->release_complete)
+				continue;
+			pending = true;
+			if (now >= next_send) {
+				if (entry->transaction_id_expired) {
+					juice_random(entry->transaction_id, sizeof(entry->transaction_id));
+					entry->transaction_id_expired = false;
+				}
+				(void)agent_send_turn_allocate_request(agent, entry, STUN_METHOD_REFRESH);
+			}
+		}
+		conn_unlock(agent);
+		if (!pending || now >= deadline)
+			break;
+		if (now >= next_send)
+			next_send = now + 100;
+		conn_interrupt(agent);
+#ifdef _WIN32
+		Sleep(10);
+#else
+		struct timespec pause = {0, 10 * 1000 * 1000};
+		nanosleep(&pause, NULL);
+#endif
+	}
 }
 
